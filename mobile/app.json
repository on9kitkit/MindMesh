{
  "expo": {
    "name": "StudyRoom Preview",
    "slug": "studyroom-preview",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "studyroom-preview",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "./plugins/withFmtXcode26Compatibility",
      "expo-asset"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.anonymous.studyroom.preview",
      "userInterfaceStyle": "automatic"
    }
  }
}
